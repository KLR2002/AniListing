@inject IApiClient ApiClient
@inject NavigationManager NavManager

<header class="sakura-navbar">
    <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
        <!-- Logo -->
        <NavLink class="navbar-brand" href="">
            <span class="brand-icon">🌸</span>
            <span>Ani<span class="brand-highlight">Listing</span></span>
        </NavLink>

        <!-- Navigation Links -->
        <nav class="d-flex align-items-center">
            <ul class="nav-links">
                <li>
                    <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">
                        <span>🔍 Discover</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link-custom" href="anime-list">
                        <span>🌸 Anime List</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link-custom" href="manga-list">
                        <span>🌸 Manga List</span>
                    </NavLink>
                </li>
            </ul>
        </nav>

        <!-- Auth Section -->
        <div class="d-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill" style="background-color: var(--sakura-100); color: var(--sakura-900); font-weight: 700; padding: 0.5rem 0.85rem; font-size: 0.88rem;">
                            🌸 @context.User.Identity?.Name
                        </span>
                        <button class="btn-sakura-outline btn-sm" @onclick="Logout">
                            Log out
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="d-flex align-items-center gap-2">
                        <NavLink class="btn-sakura-outline btn-sm" href="login">
                            Sign In
                        </NavLink>
                        <NavLink class="btn-sakura btn-sm" href="register">
                            Sign Up
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private async Task Logout()
    {
        await ApiClient.LogoutAsync();
        NavManager.NavigateTo("/", forceLoad: false);
    }
}
